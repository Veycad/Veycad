<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/directorContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/background"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.20"
                    android:text="VEYKAD  •"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/soft_surface"
                    android:clickable="true"
                    android:contentDescription="Настройки"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="☷"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="НОВЫЙ МОНТАЖ"
                android:textColor="@color/neon"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/createHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-3dp"
                android:text="@string/create_gallery_headline"
                android:textColor="@color/text_primary"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/createIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/create_gallery_intro"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="20dp" android:background="@drawable/soft_surface" android:padding="4dp">
                <Button android:id="@+id/galleryModeButton" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:minHeight="48dp" android:text="@string/capture_gallery" android:textAllCaps="false"
                    android:backgroundTint="@color/surface" android:textColor="@color/text_primary" />
                <Button android:id="@+id/autoModeButton" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:minHeight="48dp" android:text="@string/capture_auto" android:textAllCaps="false"
                    android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:id="@+id/autoCaptureOptions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/captureMusicMode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="76dp" android:text="@string/capture_music" android:textAllCaps="false" android:textSize="16sp"
                    android:gravity="start|center_vertical" android:padding="18dp" android:backgroundTint="@color/surface"
                    android:textColor="@color/text_primary" app:cornerRadius="22dp" app:strokeWidth="1dp" app:strokeColor="@color/neon" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:text="@string/capture_music_description" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/captureBestMode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="76dp" android:layout_marginTop="8dp" android:text="@string/capture_best" android:textAllCaps="false" android:textSize="16sp"
                    android:gravity="start|center_vertical" android:padding="18dp" android:backgroundTint="@color/surface"
                    android:textColor="@color/text_primary" app:cornerRadius="22dp" app:strokeWidth="1dp" app:strokeColor="@color/stroke" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:text="@string/capture_best_description" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <Button android:id="@+id/textEditorButton" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="16dp" android:text="@string/text_editor_title" android:textAllCaps="false"
                android:backgroundTint="@color/surface_high" android:textColor="@color/text_primary" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/selectVideoButton"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/video_dropzone"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_add_video"
                android:drawableEnd="@drawable/ic_style_chevron"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="20dp"
                android:text="Добавить видео"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/videoSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="middle"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="1 видео · от 15 секунд"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Стиль"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/allStylesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="Все стили"
                    android:textColor="@color/neon"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/selectStyleButton"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/style_button_background"
                android:backgroundTint="@null"
                android:drawableEnd="@drawable/ic_style_chevron"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="18dp"
                android:text="♥   Heartbeat\nПульс · повтор фразы · чёрный финал"
                android:textAllCaps="false"
                android:textColor="@color/style_button_text"
                android:textSize="15sp"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/musicSelection"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/soft_surface"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="♫ Музыка для Heartbeat подберётся автоматически"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/captureActionPreviewPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_surface"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_capture_actions_title"
                    android:textColor="@color/neon"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/captureActionPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/create_heartbeat_actions"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/create_capture_actions_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/renderButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/render_button_background"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:text="Создать монтаж  ✦"
                android:textAllCaps="false"
                android:textColor="@color/render_button_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/renderHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Сначала добавь видео"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/progressPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_surface"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView android:id="@+id/progressTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Анализирую видео" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/renderProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="14dp" android:indeterminateTint="@color/neon" android:max="100" android:progressTint="@color/neon" />
                <TextView android:id="@+id/progressDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ищу лучшие моменты и композицию" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <Button android:id="@+id/cancelRenderButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:backgroundTint="@color/surface_high" android:text="Отменить монтаж" android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView android:id="@+id/operationError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/soft_surface"
                android:textColor="@color/text_primary" android:textSize="14sp" android:visibility="gone"
                android:accessibilityLiveRegion="polite" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="✦\nСоздать" android:textColor="@color/neon" android:textSize="12sp" android:textStyle="bold" />
                <Button android:id="@+id/myEditsButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="@android:color/transparent" android:text="▣\nЭдиты" android:textAllCaps="false" android:textColor="@color/text_muted" android:textSize="12sp" />
            </LinearLayout>

            <TextView android:id="@+id/appVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/text_muted" android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/resultContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="22dp" android:paddingEnd="22dp" android:paddingBottom="36dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:letterSpacing="0.18" android:text="VEYKAD  •" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:letterSpacing="0.12" android:text="МОНТАЖ ГОТОВ" android:textColor="@color/neon" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif-black" android:gravity="center" android:text="Вот что получилось" android:textColor="@color/text_primary" android:textSize="32sp" />
            <LinearLayout android:id="@+id/resultPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical">
                <FrameLayout android:layout_width="match_parent" android:layout_height="430dp" android:background="@drawable/video_preview_surface" android:clipToOutline="true">
                    <VideoView android:id="@+id/resultVideo" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="invisible" />
                    <TextView android:id="@+id/resultLoading" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="Открываю готовый монтаж…" android:textColor="@color/white" android:textSize="15sp" />
                </FrameLayout>
                <TextView android:id="@+id/resultSummary" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="12dp" android:background="@drawable/panel_surface" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <Button android:id="@+id/addResultTextButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surface_high" android:text="@string/text_result_action" android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="14dp" android:backgroundTint="@color/neon" android:text="↓  Сохранить в галерею" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold" />
                <Button android:id="@+id/shareButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:backgroundTint="@color/surface_high" android:text="↗  Поделиться" android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/otherTakeButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:backgroundTint="@color/surface_high" android:text="@string/capture_other_take" android:textAllCaps="false" android:textColor="@color/text_primary" android:visibility="gone" />
            </LinearLayout>
            <Button android:id="@+id/newEditButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:backgroundTint="@android:color/transparent" android:text="＋  Создать новый" android:textAllCaps="false" android:textColor="@color/text_secondary" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/myEditsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="22dp" android:paddingEnd="22dp" android:paddingBottom="36dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.18" android:text="VEYKAD  •" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:letterSpacing="0.12" android:text="ТВОЯ КОЛЛЕКЦИЯ" android:textColor="@color/neon" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif-black" android:text="Мои эдиты" android:textColor="@color/text_primary" android:textSize="36sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Последний монтаж и сохранённые видео — всё в одном месте." android:textColor="@color/text_secondary" android:textSize="14sp" />
            <LinearLayout android:id="@+id/myEditsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" />
            <Button android:id="@+id/backFromEditsButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:backgroundTint="@color/neon" android:text="✦  Создать новый эдит" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/backFromSettingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/soft_surface"
                    android:clickable="true"
                    android:contentDescription="Назад"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:letterSpacing="0.20"
                    android:text="VEYKAD  •"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Space android:layout_width="42dp" android:layout_height="42dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.14"
                android:text="ПРИЛОЖЕНИЕ"
                android:textColor="@color/neon"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="Настройки"
                android:textColor="@color/text_primary"
                android:textSize="38sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:letterSpacing="0.10"
                android:text="МОНТАЖ"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_surface"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:id="@+id/defaultStyleSetting"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Стиль по умолчанию\nИспользуется для нового монтажа" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/settingsStyleValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heartbeat  ›" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

                <LinearLayout
                    android:id="@+id/qualitySetting"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Качество видео\nВлияет на размер и время рендера" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/settingsQualityValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="720p  ›" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Сохранять автоматически\nДобавлять готовые эдиты в галерею" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/autoSaveSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Уведомлять о готовности\nКогда монтаж можно открыть" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/notificationSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:letterSpacing="0.10" android:text="ПАМЯТЬ" android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_surface" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Временные файлы\nИсходники и данные рендера" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/settingsCacheValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 МБ" android:textColor="@color/neon" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <Button android:id="@+id/clearCacheButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:backgroundTint="@color/surface_high" android:text="Очистить временные файлы" android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:letterSpacing="0.10" android:text="О ПРИЛОЖЕНИИ" android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_surface" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
                <Button android:id="@+id/privacyButton" android:layout_width="match_parent" android:layout_height="64dp" android:backgroundTint="@android:color/transparent" android:gravity="start|center_vertical" android:text="Конфиденциальность                                    ›" android:textAllCaps="false" android:textColor="@color/text_primary" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />
                <Button android:id="@+id/helpButton" android:layout_width="match_parent" android:layout_height="64dp" android:backgroundTint="@android:color/transparent" android:gravity="start|center_vertical" android:text="Помощь                                                       ›" android:textAllCaps="false" android:textColor="@color/text_primary" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/stroke" />
                <Button android:id="@+id/versionButton" android:layout_width="match_parent" android:layout_height="64dp" android:backgroundTint="@android:color/transparent" android:gravity="start|center_vertical" android:text="Версия Veykad" android:textAllCaps="false" android:textColor="@color/text_primary" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">
        <ImageView android:layout_width="112dp" android:layout_height="112dp" android:background="@drawable/soft_surface" android:contentDescription="Veykad" android:padding="18dp" android:src="@drawable/ic_launcher_foreground" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:fontFamily="sans-serif-black" android:letterSpacing="0.18" android:text="VEYKAD  •" android:textColor="@color/text_primary" android:textSize="25sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Montage Engine" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="68dp" android:text="Восстанавливаем проект" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
